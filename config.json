{
  "port": 80,
  "read_timeout": "30s",
  "write_timeout": "30s",
  "idle_timeout": "120s",
  "routes": [
    {
      "path": "/api/",
      "upstreams": [
        "http://localhost:3001",
        "http://localhost:3002"
      ],
      "strategy": "round_robin",
      "set_headers": {
        "X-Forwarded-For": "$remote_addr",
        "X-Real-IP": "$remote_addr"
      }
    },
    {
      "path": "/",
      "static_dir": "/var/www/html",
      "browser_cache_ttl": "3600s"
    }
  ],
  "tls": {
    "enabled": false,
    "cert_file": "/etc/gofly/cert.pem",
    "key_file": "/etc/gofly/key.pem"
  }
}
